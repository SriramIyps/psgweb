# ─────────────────────────────────────────────
# PSG CAS CONNECT — Environment Variables
# Copy this file to .env and fill in real values
# NEVER commit .env to the repository!
# ─────────────────────────────────────────────

# Supabase Project (from Supabase Dashboard → Settings → API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Flask
FLASK_SECRET_KEY=generate-a-random-secret-here

# ─────────────────────────────────────────────
# Seed Script Passwords (used by seed_users.py only)
# Set these before running the seed script, then unset.
# ─────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@psgcas.ac.in
SEED_ADMIN_PW=ChangeMe!Admin2026

SEED_VP_EMAIL=vp@psgcas.ac.in
SEED_VP_PW=ChangeMe!VP2026

SEED_HR_EMAIL=hr@psgcas.ac.in
SEED_HR_PW=ChangeMe!HR2026

# One HOD per department — add more as needed
SEED_HOD_CS_EMAIL=hod.cs@psgcas.ac.in
SEED_HOD_CS_PW=ChangeMe!HodCS2026
SEED_HOD_CS_DEPT=Computer Science

SEED_HOD_BBA_EMAIL=hod.bba@psgcas.ac.in
SEED_HOD_BBA_PW=ChangeMe!HodBBA2026
SEED_HOD_BBA_DEPT=BBA

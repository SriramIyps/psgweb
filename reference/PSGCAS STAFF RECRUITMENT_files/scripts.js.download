//Global Values
var noofsubmit = 0

//Copy Address
const addressCopy = document.querySelector("#copy-address");
addressCopy.addEventListener('click',(e)=>{
    const perm = document.querySelectorAll('*[id^="perm"]');
    const local = document.querySelectorAll('*[id^="local"]');
    if(addressCopy.checked)
        for(var i = 0;i<perm.length;i++)
            local[i].value = perm[i].value;
    else
        for(var i = 0;i<perm.length;i++)
            local[i].value = "";
})

//Alert Message
const alerts = document.querySelectorAll(".confirmMsg")

alerts.forEach(ele=>{
    ele.onclick = (e) => {
        var msg = e.target.dataset.msg
        return confirm(msg)
    }
})

//Date Range Overlapping
function dateRangeOverlaps(a_start, a_end, b_start, b_end) {
`    // if (a_start < b_start && b_start < a_end) return true; // b starts in a
    // if (a_start < b_end   && b_end   < a_end) return true; // b ends in a
    // if (b_start <  a_start && a_end   <  b_end) return true; // a in b`
    return false;
}

function multipleDateRangeOverlaps(arguments) {
    var i, j;
    if (arguments.length % 2 !== 0)
        throw new TypeError('Arguments length must be a multiple of 2');
    for (i = 0; i < arguments.length - 2; i += 2) {
        for (j = i + 2; j < arguments.length; j += 2) {
            if (
                dateRangeOverlaps(
                    arguments[i], arguments[i+1],
                    arguments[j], arguments[j+1]
                )
            ) return true;
        }
    }
    return false;
}

//Form
document.querySelector("form").addEventListener("submit",(e)=>{

    const qualify = document.querySelectorAll(".qualification-select")
    let q = ["10th","12th","UG","PG"]
    let no = 0
    qualify.forEach(data => {
        q.forEach(i=>{
            if(i===data.value)
            {
                no+=1
            }
            console.log(no)
        })
    })


    if(no<4)
    {
        alert("Add Educational details - from 10th std to highest qualification");
        e.preventDefault();
        return false
    }


    if(noofsubmit == 0)
    {
        alert("Kindly Review once before Submitting.");
        e.preventDefault();
        noofsubmit+=1;
    }
    else if(noofsubmit == 1 && confirm("Are you sure to submit this form?"))
        return true;
    else e.preventDefault();

    const list = document.querySelector("#values")
    const educations = document.querySelectorAll(".education")
    let values = []

    educations.forEach(data => {
        const qualification = (data.querySelector(".qualification-select").value).toUpperCase()
        const time = (data.querySelector("#time").value).toUpperCase()
        const mode = (data.querySelector("#mode").value).toUpperCase()
        const answer = qualification + '-' + time + '-' + mode
        values.push(answer)
    })

    var tea = [], wea = []

    const te = document.querySelectorAll("#teaching .teaching-experience")
    const we = document.querySelectorAll("#industry .industry-experience")

    te.forEach(data=>{
        const from = data.querySelector('[data-date="from"]')
        const to = data.querySelector('[data-date="to"]')
        tea.push(from.value)
        tea.push(to.value)
    })

    we.forEach(data=>{
        const from = data.querySelector('[data-date="from"]')
        const to = data.querySelector('[data-date="to"]')
        if(from.value !== "" && to.value !== "")
        {
            wea.push(from.value)
            wea.push(to.value)
        }
    })

    console.log(tea,wea)
    if(multipleDateRangeOverlaps(tea))
    {
        alert("Teaching Experience Has been Overlapped");
        noofsubmit-=1
        e.preventDefault();
    }
    else if(multipleDateRangeOverlaps(wea))
    {
        alert("Work Experience Has been Overlapped");
        noofsubmit-=1
        e.preventDefault();
    }

    values = JSON.stringify(values)
    list.value = values
})


//Form Deletion
const del = document.querySelectorAll("#delete")
del.forEach(data=>{
    data.addEventListener("click",(e)=>{
        const cur = e.currentTarget
        cur.previousElementSibling.checked = true
        const name = cur.dataset.name
        if(name === "Language" || name === "Projects" || name === "Patents" || name === "PDF")
            cur.parentElement.parentElement.classList.add("d-none")
        else if(name === "Education")
            cur.parentElement.parentElement.parentElement.classList.add("d-none")
    })
})
    
const allDegrees = document.querySelectorAll(".degree-select")
const allQualification = document.querySelectorAll(".qualification-select")

allDegrees.forEach((data)=>{
    if(data.value == "")
    {
        var innerHtml = ['<option value="">--Select Degree--</option>']
        innerHtml.push(`<option value="NA">NA</option>`)
        data.innerHTML = innerHtml
    }
})


allQualification.forEach((data,index) => {
    const values = data.parentElement.parentElement.querySelector('.degree-select')
    const pt = data.parentElement.parentElement.querySelector('.percentage-select')
    const uni = data.parentElement.parentElement.parentElement.querySelector('.uni')

    data.addEventListener("change",(e)=>{
        pt.placeholder = " "
        uni.value = " "
        if(e.target.value == 'UG')
        {
            var list = ["BE","BTECH","BA","BSC","BLIS","BCOM","BCOM CA","BBA","BVOC"]
            var innerHtml = ['<option value="">--Select Degree--</option>']
            for(i in list)
                innerHtml.push(`<option value="${list[i]}">${list[i]}</option>`)
            values.innerHTML = innerHtml
        }
        else if(e.target.value == 'PG')
        {
            var list = ["ME","MA","MSC","MCA","MTECH","MLIS","MCOM","MBA","MSC INTEGRATED", "MSW"]
            var innerHtml = ['<option value="">--Select Degree--</option>']
            for(i in list)
                innerHtml.push(`<option value="${list[i]}">${list[i]}</option>`)
            values.innerHTML = innerHtml
        }
        else if(e.target.value == 'MPhil' || e.target.value == 'PhD')
        {
            pt.placeholder = "Commended / Highly Commended"
            var list = ["Awarded","Thesis Submitted","Synopsis Submitted","Pursuing"]
            var innerHtml = ['<option value="">--Select Degree--</option>']
            for(i in list)
                innerHtml.push(`<option value="${list[i]}">${list[i]}</option>`)
            values.innerHTML = innerHtml
        }
        else
        {
            values.innerHTML = `<option value="NA">NA</option>`
            uni.value = "NA"
        }
    })
})
}

add_more()

//Marital Status
const marital = document.querySelector('#id_marital_status')
const sn = document.querySelector('#id_spouse_name')
marital.addEventListener('change',(e)=>{
    if(e.target.value === "Married")
    {
        sn.value = " "
        // sn.disabled = false
    }
    else
    {
        sn.value = "NA"
        // sn.disabled = true
    }
})

//Diff Abled
const db = document.querySelector('#id_diff_abled')
const nt = document.querySelector('#id_nature')
db.addEventListener('change',(e)=>{
    if(e.target.value == "Yes")
    {
        nt.value = ""
    }
    else
    {
        nt.value = "NA"
    }
})


//Mobile No.
const mob = document.querySelector("#id_mobile_no")
mob.addEventListener("input",(e)=>{
  val = e.target.value
  if(val[0] == "+")
    mob.maxLength = 13
  else mob.maxLength = 10
})

//Currently Working
function curwrk(){
    const allca = document.querySelectorAll("#ca")
    allca.forEach(data=>(
        data.addEventListener("change",(e)=>{
            const val = e.currentTarget.value
            const to = data.parentElement.parentElement.querySelector('[data-date="to"]')
            if(val === "Currently Working")
            {
                to.disabled = true
                to.value = ""
            }
            else
            {
                to.disabled = false
            }
        })
    ))
}

curwrk()

//Project Status
function projectSec() {
    const projs = document.querySelectorAll("#project-status")
    projs.forEach(data=>{
        data.addEventListener("change",(e)=>{
            const dur = e.target.parentElement.parentElement.querySelector("#project-duration")
            if(e.target.value == "Ongoing")
            {
                dur.value = "NA"
                dur.readOnly = true
            }
            else
            {
                dur.value = ""
                dur.readOnly = false
            }
        })
    })
}

projectSec()

